<Window x:Class="MoviePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoviePlayer"
        Title="My Movie Player" 
        Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/Ico/icon.ico">
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="#1a1a1a" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel Margin="30,0">
                <TextBlock Text="MY CINEMA" Foreground="#E50914" FontSize="26" 
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="YEAR:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <ComboBox x:Name="YearFilter" Width="110" Height="30" Margin="0,0,20,0" 
                              VerticalContentAlignment="Center" SelectionChanged="FilterChanged" />

                    <TextBlock Text="SEARCH:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <TextBox x:Name="SearchBox" Width="200" Height="30" Padding="10,0" 
                              VerticalContentAlignment="Center" Background="#222" Foreground="White" 
                              BorderBrush="#444" TextChanged="FilterChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <StackPanel x:Name="ContinueWatchingSection" Visibility="Collapsed" Margin="10,10,10,20">
                    <TextBlock Text="CONTINUE WATCHING" Foreground="White" FontSize="18" FontWeight="Bold" Margin="10,0,0,15"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ContinueWatchingGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10" Width="210">
                                        <Border CornerRadius="6" ClipToBounds="True" Background="#222" Cursor="Hand" 
                                                MouseLeftButtonUp="MovieCard_Click" MouseLeftButtonDown="MovieCard_MouseDown">
                                            <Grid>
                                                <Image Source="{Binding PosterPath}" Height="120" Stretch="UniformToFill" Opacity="0.6"/>
                                                <Ellipse Width="40" Height="40" Fill="#E50914" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Text="▶" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" 
                                                   Margin="0,8,0,0" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Rectangle Height="1" Fill="#333" Margin="10,20,10,10"/>
                </StackPanel>

                <TextBlock Text="ALL MOVIES" Foreground="Gray" FontSize="14" FontWeight="Bold" Margin="20,0,0,10"/>
                <ItemsControl x:Name="MovieDisplayGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12" Width="160">
                                <Border CornerRadius="8" ClipToBounds="True" Background="#222" Cursor="Hand"
                                        MouseLeftButtonUp="MovieCard_Click"
                                        MouseLeftButtonDown="MovieCard_MouseDown">
                                    <Image Source="{Binding PosterPath}" Height="240" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" 
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Background="#181818" BorderBrush="#333" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <Border CornerRadius="10" ClipToBounds="True" Background="#111" Margin="0,0,0,20">
                        <Image x:Name="SelectedPoster" Height="450" Stretch="UniformToFill" />
                    </Border>

                    <Button x:Name="PlayButton" Content="▶  PLAY MOVIE" Height="50" Margin="0,0,0,20"
                            Background="#E50914" Foreground="White" FontSize="18" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="PlayButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock x:Name="SelectedTitle" Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="SelectedYearLabel" Foreground="#E50914" FontSize="15" Margin="0,0,12,0"/>
                        <TextBlock x:Name="SelectedRuntimeLabel" Foreground="Gray" FontSize="15" Margin="0,0,12,0"/>
                        <TextBlock x:Name="SelectedImdbRating" Foreground="#F5C518" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,20,0,0">
                        <Button x:Name="ImdbButton" Content="IMDb" Height="35" Background="#222" Foreground="#F5C518" Click="ImdbButton_Click"/>
                        <Button x:Name="LetterboxdButton" Content="LETTERBOXD" Height="35" Background="#222" Foreground="#00e054" Click="LetterboxdButton_Click" Margin="5,0,0,0"/>
                    </UniformGrid>

                    <Rectangle Height="1" Fill="#333" Margin="0,20"/>
                    <TextBlock x:Name="SelectedDescription" Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>