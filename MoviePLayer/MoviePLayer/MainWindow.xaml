<Window x:Class="MoviePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Movie Player" Height="750" Width="1250"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="#1a1a1a" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel Margin="30,0">
                <TextBlock Text="MY CINEMA" Foreground="#E50914" FontSize="26" 
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="YEAR:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <ComboBox x:Name="YearFilter" Width="110" Height="30" Margin="0,0,20,0" 
                              VerticalContentAlignment="Center" SelectionChanged="FilterChanged" />

                    <TextBlock Text="SEARCH:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <TextBox x:Name="SearchBox" Width="200" Height="30" Padding="10,0" 
                              VerticalContentAlignment="Center" Background="#222" Foreground="White" 
                              BorderBrush="#444" TextChanged="FilterChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MovieDisplayGrid" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="12" Width="160">
                            <Border CornerRadius="8" ClipToBounds="True" Background="#222" Cursor="Hand" 
                                    MouseLeftButtonUp="MovieCard_Click">
                                <Grid MouseDown="MovieBorder_MouseDown">
                                    <Image Source="{Binding PosterPath}" Height="240" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" 
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Background="#181818" BorderBrush="#333" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <TextBlock Text="SELECTED MOVIE" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border CornerRadius="10" ClipToBounds="True" Background="#111" Margin="0,0,0,20">
                        <Image x:Name="SelectedPoster" Height="450" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock x:Name="SelectedTitle" Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="SelectedYearLabel" Foreground="#E50914" FontSize="15" Margin="0,0,12,0"/>
                        <TextBlock x:Name="SelectedRuntimeLabel" Foreground="Gray" FontSize="15" Margin="0,0,12,0"/>

                        <TextBlock x:Name="SelectedImdbRating" Foreground="#F5C518" FontSize="15" FontWeight="Bold" Margin="0,0,12,0"/>

                        <TextBlock x:Name="SelectedLbRating" Foreground="#00e054" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,20,0,0">
                        <Button x:Name="ImdbButton" Content="IMDb" 
                                Margin="0,0,5,0" Height="38"
                                Background="#222" Foreground="#F5C518" 
                                BorderBrush="#444" BorderThickness="1" 
                                FontSize="11" FontWeight="Bold" Cursor="Hand"
                                Click="ImdbButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="LetterboxdButton" Content="LETTERBOXD" 
                                Margin="5,0,0,0" Height="38"
                                Background="#222" Foreground="#00e054" 
                                BorderBrush="#444" BorderThickness="1" 
                                FontSize="11" FontWeight="Bold" Cursor="Hand"
                                Click="LetterboxdButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </UniformGrid>

                    <Rectangle Height="1" Fill="#333" Margin="0,20"/>

                    <TextBlock x:Name="SelectedDescription" Foreground="#AAAAAA" FontSize="15" 
                               TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>